# AI_CONFIG_KEY: base64 encoded random 32-byte server encryption key. Configure as a Sites secret.
# Never commit API keys or encryption keys.

# Baidu Netdisk (configure through Sites runtime, never commit real values)
# BAIDU_CLIENT_ID=
# BAIDU_CLIENT_SECRET= (secret)
# BAIDU_SITE_ORIGIN=https://your-site.example
# BAIDU_APP_FOLDER=/apps/approved-app-directory
